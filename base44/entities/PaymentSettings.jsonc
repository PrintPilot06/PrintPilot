{
  "name": "PaymentSettings",
  "type": "object",
  "properties": {
    "cashapp_link": {
      "type": "string"
    },
    "price_per_credit": {
      "type": "number",
      "default": 0.05
    },
    "min_credits": {
      "type": "number",
      "default": 50
    }
  },
  "required": [
    "cashapp_link"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}