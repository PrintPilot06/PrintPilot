{
  "name": "CreditAccount",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "lifetime_purchased": {
      "type": "number",
      "default": 0
    },
    "lifetime_spent": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "user_id",
    "balance"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}