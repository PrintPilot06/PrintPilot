{
  "name": "PrintJob",
  "type": "object",
  "properties": {
    "model_name": {
      "type": "string"
    },
    "printer_name": {
      "type": "string"
    },
    "material": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "printing",
        "completed",
        "failed",
        "cancelled"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green",
        "red",
        "gray"
      ]
    },
    "duration_seconds": {
      "type": "number"
    },
    "estimated_seconds": {
      "type": "number"
    },
    "filament_grams": {
      "type": "number"
    },
    "layer_count": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "model_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}