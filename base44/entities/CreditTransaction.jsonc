{
  "name": "CreditTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "grant",
        "purchase",
        "spend"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray"
      ]
    },
    "credits": {
      "type": "number"
    },
    "amount_usd": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "balance_after": {
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "kind",
    "credits"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}